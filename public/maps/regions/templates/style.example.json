{
  "version": 8,
  "name": "DeadNET Offline Streets",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://__DEADNET_ARCHIVE__",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "glyphs": "./fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#e7e8df" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#a9cbd0" } },
    { "id": "landuse", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "paint": { "fill-color": "#d9e2d0", "fill-opacity": 0.8 } },
    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13, "paint": { "fill-color": "#c6c5ba", "fill-outline-color": "#aaa99f" } },
    { "id": "roads", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "paint": { "line-color": "#f5f0df", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 14, 3] } },
    { "id": "road-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-size": 10, "symbol-placement": "line" }, "paint": { "text-color": "#47544c", "text-halo-color": "#f5f0df", "text-halo-width": 1 } },
    { "id": "place-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-size": 11 }, "paint": { "text-color": "#34453a", "text-halo-color": "#e7e8df", "text-halo-width": 1 } }
  ]
}
